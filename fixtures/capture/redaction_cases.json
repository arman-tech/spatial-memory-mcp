        "$concat": [
          "AWS_ACCESS_KEY_ID=",
          "AKIA",
          "IOSFODNN7EXAMPLE"
        ]
      },
      "expect": {
        "contains": [
          "[REDACTED_AWS_KEY]"
        ],
        "not_contains": [
          {
            "$concat": [
              "AKIA",
              "IOSFODNN7EXAMPLE"
            ]
          }
        ],
        "redaction_count_min": 1
