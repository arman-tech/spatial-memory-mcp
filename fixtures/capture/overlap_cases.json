{
  "description": "Transcript-vs-PostToolUse dedup (overlap_detector). Test data only. `setup.files_in_new` are files to create in {TMP}/new/ before the call (`text` is UTF-8 text written byte-exact, `hex` raw bytes, `dir: true` a directory). `expect` holds what the tests assert as checks [{path, op, value}] evaluated against {\"result\": <value>} (for _content_hash: {\"relation\": \"equal\"|\"not_equal\"}). Hash sets are given as sorted lists of lowercase hex SHA-256.",
  "sources": {
    "module": "origin/feature/v2-implementations:spatial_memory/hooks/overlap_detector.py",
    "tests": "origin/feature/v2-implementations:tests/unit/test_hooks_overlap_detector.py",
    "identical_on": "master (source and tests have no diff)"
  },
  "rules": {
    "get_queued_hashes": [
      "new_dir = queue_dir/new; not a directory -> empty set.",
      "files = new_dir.glob('*.json') sorted by file name descending (code-point order). OSError -> empty set.",
      "For each of files[:max_age_files] (default 50): parse read_text(utf-8) as JSON; content = data.get('content', '').",
      "If content is a str and content.strip() is non-empty: add _content_hash(content).",
      "JSONDecodeError, OSError and ValueError (incl. UnicodeDecodeError/UnicodeEncodeError) skip the file. AttributeError (JSON that is not an object) is NOT caught and escapes."
    ],
    "is_duplicate": "False if content is empty or the hash set is empty; else _content_hash(content) in set.",
    "_content_hash": "sha256(content.strip().lower().encode('utf-8')).hexdigest() (Python str.strip/str.lower).",
    "pipeline_note": "run_transcript_pipeline calls is_duplicate on the raw extracted text BEFORE redaction, while queue files hold redacted content, so text containing a secret never matches the queue entry PostToolUse wrote for it. Source: origin/feature/v2-implementations:spatial_memory/hooks/transcript_pipeline.py::run_transcript_pipeline"
  },
  "computed": [
    "*.computed_result",
    "*.computed_result_length",
    "*.computed_files_hashed",
    "*.computed_exception",
    "*.computed_queued_hashes",
    "*.computed_hash_a",
    "*.computed_hash_b",
    "*.computed_glob_names_*",
    "content_hash_table[*].computed_*"
  ],
