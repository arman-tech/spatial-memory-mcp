{
  "id": "cc_user_prompt_submit_formatted_block",
  "event": "UserPromptSubmit",
  "client": "claude-code",
  "argv": [
    "user-prompt-submit",
    "--client",
    "claude-code"
  ],
  "origin": "test",
  "source_test": "origin/feature/v2-implementations:tests/unit/test_user_prompt_submit_hook.py::test_recall_returns_formatted_block",
  "notes": "hybrid_recall is faked (the test uses MagicMock + HybridMemoryMatch). Only .content and .similarity are read by _format_top_k.",
  "env": {
    "SPATIAL_MEMORY_MEMORY_PATH": "{TMP}",
    "CLAUDE_PROJECT_DIR": "{TMP}",
    "SPATIAL_MEMORY_AMBIENT_RECALL": "on",
    "SPATIAL_MEMORY_AMBIENT_RECALL_TOP_K": "3"
  },
  "stdin_json": {
    "session_id": "abc123",
    "cwd": "/tmp/proj",
    "prompt": "How do I configure the embedding model?"
  },
  "fake_recall": {
    "memories": [
      {
        "content": "memory content 0",
        "similarity": 0.9
      },
      {
        "content": "memory content 1",
        "similarity": 0.8
      },
      {
        "content": "memory content 2",
        "similarity": 0.7
      }
    ]
  },
  "test_asserts": [
    "assert out is not None",
    "assert isinstance(out, str)",
    "for i in range(3): assert f\"memory content {i}\" in out",
    "assert kwargs.get(\"limit\") == 3"
  ],
  "checks": [
    {
      "path": "stdout",
      "op": "contains",
      "value": "memory content 0"
    },
    {
      "path": "stdout",
      "op": "contains",
      "value": "memory content 1"
    },
    {
      "path": "stdout",
      "op": "contains",
      "value": "memory content 2"
    },
    {
      "path": "recall_calls.1.limit",
      "op": "eq",
      "value": 3
    }
  ],
  "checks_target_in_test": "origin/feature/v2-implementations:spatial_memory/hooks/dispatcher.py::dispatch",
  "checks_hold_on": {
    "v2_dispatcher": true,
    "master_dispatcher": false
  },
  "expected": {
    "stdout": "[spatial-memory] ambient recall:\n  1. (0.90) memory content 0\n  2. (0.80) memory content 1\n  3. (0.70) memory content 2\n",
    "queue_files": [],
    "queue_tmp_leftovers": [],
    "state_files": {},
    "hook_errors_log": null,
    "other_files": [],
    "recall_calls": [
      {
        "$create_all": true
      },
      {
        "query": "How do I configure the embedding model?",
        "limit": 3,
        "namespace": null
      }
    ]
  },
  "variants": {
    "master_dispatcher": {
      "stdout": "",
      "queue_files": [],
      "queue_tmp_leftovers": [],
      "state_files": {},
      "hook_errors_log": null,
      "other_files": [],
      "recall_calls": []
    }
  },
  "computed": [
    "expected",
    "variants",
    "checks_hold_on"
  ]
}
