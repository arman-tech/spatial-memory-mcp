{
  "description": "Hook stdin payloads run through the real Python hook entrypoints. One file per payload. 'expected' is the v2 dispatcher (the entrypoint v2's plugin/hooks/hooks.json and setup_hooks register). 'variants' holds the legacy per-event scripts and master; {\"same_as\": X} means byte-identical results.",
  "result_schema": {
    "stdout": "exact text written to sys.stdout (LF; Python on Windows would translate to CRLF on a real pipe)",
    "queue_files": "parsed pending-saves/new/*.json in creation order; timestamp replaced by {TIMESTAMP}",
    "queue_tmp_leftovers": "files left in pending-saves/tmp (always empty)",
    "state_files": "pending-saves/state/<session>.json contents",
    "hook_errors_log": "lines of hook-errors.log with the [timestamp] prefix replaced by [{TIMESTAMP}], or null when absent",
    "other_files": "any other file the run created under {TMP}",
    "recall_calls": "UserPromptSubmit only: calls made to the fake factory ($create_all) and hybrid_recall kwargs"
  },
  "placeholders": {
    "{TMP}": "a fresh empty directory per run, forward slashes, absolute (e.g. C:/.../run). Substitute in env, files, stdin; results use it back.",
    "{TIMESTAMP}": "UTC time formatted %Y-%m-%dT%H:%M:%SZ"
  },
  "stdin_encoding": "stdin_json is fed as json.dumps(value, ensure_ascii=False) encoded UTF-8; stdin_text as UTF-8; stdin_hex as raw bytes.",
  "origin_values": {
    "test": "payload copied from the named test",
    "constructed": "payload assembled from inputs in the named tests; every output is computed",
