    ],
    "other_files": []
  },
  "variants": {
    "v2_legacy_entrypoint": {
      "stdout": "{\"continue\": true, \"suppressOutput\": true}\n",
      "queue_files": [],
      "queue_tmp_leftovers": [],
      "state_files": {},
      "hook_errors_log": null,
      "other_files": []
    },
    "master_dispatcher": {
      "same_as": "expected"
    },
    "master_legacy_entrypoint": {
      "same_as": "v2_legacy_entrypoint"
    }
  },
  "computed": [
    "expected",
    "variants",
    "checks_hold_on"
  ]
