{
  "id": "cc_session_start_resume",
  "event": "SessionStart",
  "client": "claude-code",
  "argv": [
    "session-start",
    "--client",
    "claude-code"
  ],
  "origin": "test",
  "source_test": "origin/feature/v2-implementations:tests/unit/test_hooks_session_start.py::TestTriggerSources::test_resume_emits_context",
  "env": {
    "SPATIAL_MEMORY_MEMORY_PATH": "{TMP}",
    "CLAUDE_PROJECT_DIR": "{TMP}"
  },
  "stdin_json": {
    "source": "resume",
    "session_id": "s2"
  },
  "test_asserts": [
    "assert output[\"hookSpecificOutput\"][\"hookEventName\"] == \"SessionStart\""
  ],
  "checks": [
    {
      "path": "stdout_json.hookSpecificOutput.hookEventName",
      "op": "eq",
      "value": "SessionStart"
    }
  ],
  "checks_target_in_test": "origin/feature/v2-implementations:spatial_memory/hooks/session_start.py::main",
  "checks_hold_on": {
    "v2_dispatcher": true,
    "v2_legacy_entrypoint": true,
    "master_dispatcher": true,
    "master_legacy_entrypoint": true
  },
  "expected": {
    "stdout": "{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"SPATIAL MEMORY: Call `recall` with a brief summary of the user's apparent task/context to load relevant memories from previous sessions.\"}}\n",
    "queue_files": [],
    "queue_tmp_leftovers": [],
    "state_files": {},
    "hook_errors_log": null,
    "other_files": []
  },
  "variants": {
    "v2_legacy_entrypoint": {
      "same_as": "expected"
    },
    "master_dispatcher": {
      "same_as": "expected"
    },
    "master_legacy_entrypoint": {
      "same_as": "expected"
    }
  },
  "computed": [
    "expected",
    "variants",
    "checks_hold_on"
  ]
}
